<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="SynToolkit.Views.PowerPlanEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Opened="Dialog_Opened"
    Closing="Dialog_Closing"
    Closed="Dialog_Closed">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <x:Double x:Key="ContentDialogMaxWidth">1020</x:Double>
            <x:Double x:Key="ContentDialogMaxHeight">860</x:Double>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <Grid x:Name="DialogContent" Width="900" Height="620" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Height="36">
            <TextBlock x:Name="EditorTitle" VerticalAlignment="Center"
                       FontSize="20" FontWeight="SemiBold" Text="Edit power plan" />
            <Button Width="32" Height="32" HorizontalAlignment="Right"
                    AutomationProperties.Name="Close power-plan editor"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    Click="CloseButton_Click" ToolTipService.ToolTip="Close editor">
                <FontIcon FontSize="12" Glyph="&#xE8BB;" />
            </Button>
        </Grid>

        <TextBlock x:Name="EditorHint" Grid.Row="1" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <TextBox x:Name="SearchBox" Grid.Row="2"
                 AutomationProperties.Name="Search editable power settings"
                 PlaceholderText="Search setting, category, description, or GUID"
                 TextChanged="SearchBox_TextChanged" />

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Loading settings..." />
            <ProgressRing x:Name="BusyRing" Grid.Column="1" Width="18" Height="18"
                          IsActive="True" />
        </Grid>

        <Grid Grid.Row="4" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="CategoryList" Grid.Column="0"
                      AutomationProperties.Name="Power setting categories"
                      SelectionMode="Single"
                      SelectionChanged="CategoryList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{Binding Name}" />
                            <TextBlock Grid.Column="1" Text="{Binding Count}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ScrollViewer x:Name="SettingsScroll" Grid.Column="1">
                <ItemsControl x:Name="GroupsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Margin="8,4,8,8" FontSize="16"
                                           FontWeight="SemiBold" Text="{Binding Name}" />
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,9" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="165" />
                                                        <ColumnDefinition Width="165" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   ToolTipService.ToolTip="{Binding SettingId}" />
                                                        <TextBlock Text="{Binding Description}" MaxLines="2"
                                                                   FontSize="12" TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{Binding RangeHint}" FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock Text="Plugged in" FontSize="12"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <ComboBox x:Name="AcChoiceBox" HorizontalAlignment="Stretch"
                                                                  ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
                                                                  SelectedItem="{Binding AcChoice, Mode=TwoWay}"
                                                                  Visibility="{Binding ChoiceVisibility}"
                                                                  IsEnabled="{Binding HasAc}"
                                                                  SelectionChanged="Choice_SelectionChanged" />
                                                        <NumberBox x:Name="AcNumberBox" HorizontalAlignment="Stretch"
                                                                   Value="{Binding AcNumber, Mode=TwoWay}"
                                                                   Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                                   SmallChange="{Binding Increment}"
                                                                   SpinButtonPlacementMode="Compact"
                                                                   Visibility="{Binding NumberVisibility}"
                                                                   IsEnabled="{Binding HasAc}"
                                                                   LostFocus="Number_LostFocus" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="3">
                                                        <TextBlock Text="On battery" FontSize="12"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <ComboBox x:Name="DcChoiceBox" HorizontalAlignment="Stretch"
                                                                  ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
                                                                  SelectedItem="{Binding DcChoice, Mode=TwoWay}"
                                                                  Visibility="{Binding ChoiceVisibility}"
                                                                  IsEnabled="{Binding HasDc}"
                                                                  SelectionChanged="Choice_SelectionChanged" />
                                                        <NumberBox x:Name="DcNumberBox" HorizontalAlignment="Stretch"
                                                                   Value="{Binding DcNumber, Mode=TwoWay}"
                                                                   Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                                   SmallChange="{Binding Increment}"
                                                                   SpinButtonPlacementMode="Compact"
                                                                   Visibility="{Binding NumberVisibility}"
                                                                   IsEnabled="{Binding HasDc}"
                                                                   LostFocus="Number_LostFocus" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="5" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorText" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            <Button x:Name="SaveAsButton" Grid.Column="1" Content="Save as...">
                <Button.Flyout>
                    <Flyout x:Name="SaveAsFlyout">
                        <StackPanel Width="260" Spacing="8">
                            <TextBlock Text="Create a copy" FontWeight="SemiBold" />
                            <TextBlock Text="The original plan will stay unchanged. The copy becomes active."
                                       TextWrapping="Wrap" />
                            <TextBox x:Name="CopyNameBox" Header="New plan name" MaxLength="80" />
                            <Button Content="Create and save" Style="{StaticResource AccentButtonStyle}"
                                    Click="ConfirmSaveAsButton_Click" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="SaveButton" Grid.Column="2" Content="Save changes"
                    Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click" />
        </Grid>
    </Grid>
</ContentDialog>
