<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SynToolkit.Views.SpecsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SynToolkit.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="using:SynToolkit.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodel:SpecsPageViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:FontIconConverter x:Key="FontIconConverter" />
        <local:ImageSourceConverter x:Key="ImageSourceConverter" />
    </Page.Resources>

    <Grid Margin="55,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,24,36,8"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Specs" />
        <TextBlock
            Grid.Row="1"
            Margin="0,0,36,18"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="A read-only snapshot of this system's hardware and Windows version. Nothing here can be changed."
            TextWrapping="Wrap" />

        <InfoBar
            Grid.Row="2"
            Margin="0,0,36,18"
            IsClosable="True"
            IsOpen="{Binding HasError, Mode=OneWay}"
            Message="{Binding ErrorMessage, Mode=OneWay}"
            Severity="Error"
            Title="Specs" />

        <ProgressRing
            Grid.Row="3"
            Width="32"
            Height="32"
            Margin="0,24,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsActive="{Binding IsLoading, Mode=OneWay}"
            Visibility="{Binding IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <ScrollViewer Grid.Row="3">
            <StackPanel Margin="0,0,36,48">

                <controls:SettingsCard
                    Margin="0,0,0,10"
                    Description="{Binding CpuDetailsText, Mode=OneWay}"
                    Header="{Binding CpuName, Mode=OneWay}"
                    Style="{StaticResource ConfigurationSettingsCardTemplate}">
                    <controls:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///assets/Icons/Cpu.png" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Margin="0,0,0,10"
                    Header="Motherboard"
                    Style="{StaticResource ConfigurationSettingsCardTemplate}">
                    <controls:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///assets/Icons/Motherboard.png" />
                    </controls:SettingsCard.HeaderIcon>
                    <TextBlock VerticalAlignment="Center" Text="{Binding MotherboardText, Mode=OneWay}" />
                </controls:SettingsCard>

                <controls:SettingsExpander
                    Margin="0,0,0,10"
                    Description="{Binding TotalMemoryText, Mode=OneWay}"
                    Header="Memory"
                    Style="{StaticResource ConfigurationSettingsExpanderTemplate}">
                    <controls:SettingsExpander.HeaderIcon>
                        <ImageIcon Source="ms-appx:///assets/Icons/Ram.png" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <ItemsControl ItemsSource="{Binding MemoryModules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:MemoryModuleDisplay">
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind ManufacturerText, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind CapacityText, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander
                    Margin="0,0,0,10"
                    Header="Graphics"
                    Style="{StaticResource ConfigurationSettingsExpanderTemplate}">
                    <controls:SettingsExpander.HeaderIcon>
                        <ImageIcon Source="{Binding GraphicsHeaderIcon, Mode=OneWay, Converter={StaticResource ImageSourceConverter}}" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <ItemsControl ItemsSource="{Binding Gpus}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:GpuSpecDisplay">
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Width="24"
                                                Height="24"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Top"
                                                Source="{x:Bind IconPath, Mode=OneWay, Converter={StaticResource ImageSourceConverter}}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind DriverVersionText, Mode=OneWay}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="2"
                                                Margin="10,0,0,0"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind VramText, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander
                    Margin="0,0,0,10"
                    Header="Storage"
                    Style="{StaticResource ConfigurationSettingsExpanderTemplate}">
                    <controls:SettingsExpander.HeaderIcon>
                        <ImageIcon Source="ms-appx:///assets/Icons/Storage.png" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <ItemsControl ItemsSource="{Binding StorageDrives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:StorageDriveDisplay">
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Model, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind TypeText, Mode=OneWay}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind SizeText, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsCard
                    Margin="0,0,0,10"
                    Header="Windows"
                    Style="{StaticResource ConfigurationSettingsCardTemplate}">
                    <controls:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///assets/Icons/Windows.png" />
                    </controls:SettingsCard.HeaderIcon>
                    <TextBlock VerticalAlignment="Center" Text="{Binding WindowsText, Mode=OneWay}" TextWrapping="Wrap" />
                </controls:SettingsCard>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
