<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SynToolkit.Views.PowerPlansPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <Style x:Key="CategoryTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,10" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="55,0,0,48">
            <Grid Margin="0,24,36,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Power plans" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="RestorePreviousButton"
                        Click="RestorePreviousButton_Click"
                        Content="Restore Previous"
                        ToolTipService.ToolTip="Return to the plan that was active before the last SynToolkit import or activation." />
                    <Button
                        x:Name="RefreshButton"
                        Click="RefreshButton_Click"
                        Content="Refresh" />
                </StackPanel>
            </Grid>
            <TextBlock
                Margin="0,0,36,24"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Import and manage Windows power plans directly from SynToolkit. Nothing is changed during setup."
                TextWrapping="Wrap" />

            <InfoBar
                x:Name="ElevationInfoBar"
                Margin="0,0,36,18"
                IsClosable="False"
                IsOpen="False"
                Message="Power-plan changes are disabled in this session. Restart SynToolkit as administrator to import, activate, restore, or remove plans."
                Severity="Warning"
                Title="Administrator access required" />

            <InfoBar
                x:Name="OperationInfoBar"
                Margin="0,0,36,18"
                IsOpen="False"
                IsClosable="True" />

            <InfoBar
                Margin="0,0,36,18"
                IsClosable="False"
                IsOpen="True"
                Message="The supplied SOS.pow settings are preserved exactly. SynToolkit imports and activates it only when you choose Import and activate, and records your current plan for recovery."
                Severity="Informational"
                Title="Safe, explicit import" />

            <TextBlock
                Margin="0,0,36,18"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                <Run Text="Want to create your own?" />
                <Hyperlink NavigateUri="https://www.youtube.com/watch?v=GJ3omzm-CYU">Watch the tutorial →</Hyperlink>
            </TextBlock>

            <TextBlock Style="{StaticResource CategoryTitle}" Text="Currently active" />
            <controls:SettingsCard
                Header="Current power plan"
                Description="The plan Windows is using right now."
                Style="{StaticResource ConfigurationSettingsCardTemplate}">
                <controls:SettingsCard.HeaderIcon>
                    <ImageIcon Source="ms-appx:///assets/Icons/Energy.png" />
                </controls:SettingsCard.HeaderIcon>
                <Grid MinWidth="245">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="CurrentPlanName"
                            FontWeight="SemiBold"
                            Text="Reading Windows power settings..."
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="CurrentPlanId"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="PreviousPlanState"
                            Margin="0,4,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No previous plan has been recorded."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ProgressRing
                        x:Name="StatusProgressRing"
                        Grid.Column="1"
                        Width="18"
                        Height="18"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        IsActive="False"
                        Visibility="Collapsed" />
                </Grid>
            </controls:SettingsCard>

            <controls:SettingsExpander
                Header="Recovery"
                Description="Return to the plan you were using before, or select Windows Balanced."
                Style="{StaticResource ConfigurationSettingsExpanderTemplate}">
                <controls:SettingsExpander.HeaderIcon>
                    <ImageIcon Source="ms-appx:///assets/Icons/Update.png" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        Header="Windows Balanced"
                        Description="Activates the standard Windows Balanced plan.">
                        <Button
                            x:Name="ActivateBalancedButton"
                            Click="ActivateBalancedButton_Click"
                            Content="Activate Balanced" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Windows power settings"
                        Description="Open the Windows Settings power and sleep page.">
                        <Button
                            Click="OpenPowerSettingsButton_Click"
                            Content="Open settings" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Restore default power plans"
                        Description="Resets every Windows power plan to its default configuration, removing SynToolkit's plan and any other custom plans. This cannot be undone.">
                        <Button
                            x:Name="RestoreDefaultSchemesButton"
                            Click="RestoreDefaultSchemesButton_Click"
                            Content="Restore defaults" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <TextBlock Style="{StaticResource CategoryTitle}" Text="Manage plans" />
            <controls:SettingsExpander
                Header="SynToolkit SOS Performance"
                Description="The official SOS.pow plan, embedded securely inside SynToolkit."
                Style="{StaticResource ConfigurationSettingsExpanderTemplate}">
                <controls:SettingsExpander.HeaderIcon>
                    <BitmapIcon ShowAsMonochrome="False" UriSource="/assets/logo/SynToolkit.ico" />
                </controls:SettingsExpander.HeaderIcon>
                <Border
                    Padding="10,4"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="12">
                    <TextBlock
                        x:Name="BuiltInPlanState"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="Checking..." />
                </Border>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        Header="Import and activate"
                        Description="Imports a fresh copy of SOS.pow and makes it the active Windows plan.">
                        <Button
                            x:Name="ImportBuiltInButton"
                            Click="ImportBuiltInButton_Click"
                            Content="Import and activate"
                            Style="{StaticResource AccentButtonStyle}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Activate existing plan"
                        Description="Switches to the SynToolkit plan without importing it again.">
                        <Button
                            x:Name="ActivateBuiltInButton"
                            Click="ActivateBuiltInButton_Click"
                            Content="Activate" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Remove SynToolkit plan"
                        Description="Restores the previous plan when needed, then removes only SynToolkit's plan.">
                        <Button
                            x:Name="RemoveBuiltInButton"
                            Click="RemoveBuiltInButton_Click"
                            Content="Remove" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsCard
                Header="Import a .pow file"
                Description="Choose any local Windows power-plan file. SynToolkit imports it with a new ID and activates it."
                Style="{StaticResource ConfigurationSettingsCardTemplate}">
                <controls:SettingsCard.HeaderIcon>
                    <ImageIcon Source="ms-appx:///assets/Icons/External.png" />
                </controls:SettingsCard.HeaderIcon>
                <Button
                    x:Name="ImportCustomButton"
                    Click="ImportCustomButton_Click"
                    Content="Choose .pow file" />
            </controls:SettingsCard>

            <Grid Margin="0,8,36,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="Bundled power plans" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Pre-packaged power plans from the community. Select one to import and activate it."
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    x:Name="RefreshBundledPlansButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="RefreshBundledPlansButton_Click"
                    Content="Refresh" />
            </Grid>

            <AutoSuggestBox
                x:Name="BundledPlansSearchBox"
                Margin="0,0,36,16"
                PlaceholderText="Search power plans"
                TextChanged="BundledPlansSearchBox_TextChanged">
                <AutoSuggestBox.QueryIcon>
                    <FontIcon Glyph="&#xE721;" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>

            <StackPanel
                x:Name="BundledPlansEmptyState"
                Margin="0,0,36,18"
                Visibility="Collapsed">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="No power plans available. The Assets\PowerPlans folder may be missing."
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                x:Name="BundledPlansNoMatchesState"
                Margin="0,0,36,18"
                Visibility="Collapsed">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="No power plans match your search."
                    TextWrapping="Wrap" />
            </StackPanel>

            <ItemsControl
                x:Name="BundledPlansListView"
                Margin="0,0,36,18">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:SettingsCard
                            Header="{Binding DisplayName}"
                            Description="{Binding Description}"
                            Style="{StaticResource ConfigurationSettingsCardTemplate}">
                            <controls:SettingsCard.HeaderIcon>
                                <ImageIcon Source="ms-appx:///assets/Icons/Energy.png" />
                            </controls:SettingsCard.HeaderIcon>
                            <Button
                                Click="ImportBundledPlanButton_Click"
                                Content="Import and activate"
                                Tag="{Binding}" />
                        </controls:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
