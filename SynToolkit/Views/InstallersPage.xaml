                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Border
                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Style="{StaticResource InstalledBadge}">
                                            <TextBlock Style="{StaticResource InstalledBadgeText}" Text="INSTALLED" />
                                        </Border>
                                        <CheckBox
                                            Style="{StaticResource CompactAppCheckBoxStyle}"
                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityInverseConverter}}"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </StackPanel>
                                </controls:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl x:Name="RuntimesGridView" Margin="0,0,36,18" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid
                                    ItemWidth="200"
                                    MaximumRowsOrColumns="5"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,8,8"
                                    Padding="14"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Style="{StaticResource MonogramBorder}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Monogram}" />
                                            </Border>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{Binding DisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0,8,0,10"
                                            MaxLines="2"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding ShortDescription}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            ToolTipService.ToolTip="{Binding ShortDescription}" />
                                        <StackPanel Grid.Row="2">
                                            <Border
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Style="{StaticResource InstalledBadge}">
                                                <TextBlock Style="{StaticResource InstalledBadgeText}" Text="INSTALLED" />
                                            </Border>
                                            <CheckBox
                                                Style="{StaticResource AppCheckBoxStyle}"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityInverseConverter}}"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                Content="Select" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- GPU Drivers Section (Stub) -->
                <StackPanel x:Name="DriversSection" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource CategoryTitle}" Text="GPU Drivers" />
                    <Border
                        Margin="0,0,36,18"
                        Padding="24"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <FontIcon
                                FontSize="32"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE8B7;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Driver Detection Coming Soon" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="GPU driver installation requires additional complexity and will be implemented in a future update."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>

            <!-- Install Selected Button -->
            <Button
                x:Name="InstallSelectedButton"
                Margin="0,16,36,0"
                HorizontalAlignment="Right"
                Click="InstallSelectedButton_Click"
                Content="Install Selected"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}" />

        </StackPanel>
    </ScrollViewer>
</Page>
