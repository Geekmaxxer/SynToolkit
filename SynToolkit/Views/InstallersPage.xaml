<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SynToolkit.Views.InstallersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SynToolkit.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverseConverter" />
        <Style x:Key="CategoryTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,10" />
        </Style>

        <Style x:Key="InstalledBadge" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="InstalledBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CategoryTabButton" TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="MonogramBorder" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="55,0,0,48">
            <!-- Page Header -->
            <TextBlock
                Margin="0,24,36,8"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Installers" />
            <TextBlock
                x:Name="HeaderDescription"
                Margin="0,0,36,24"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Scanning for installed apps..."
                TextWrapping="Wrap" />

            <!-- Info Bars -->
            <InfoBar
                x:Name="OperationInfoBar"
                Margin="0,0,36,18"
                IsClosable="True"
                IsOpen="False" />

            <InfoBar
                Margin="0,0,36,18"
                IsClosable="False"
                IsOpen="True"
                Message="Select apps you'd like to install, then click Install Selected. Download URLs will be added in a future update."
                Severity="Informational"
                Title="Coming soon" />

            <!-- Action Row: Search, Category Tabs, Actions -->
            <Grid Margin="0,0,36,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <AutoSuggestBox
                    x:Name="SearchBox"
                    Grid.Column="0"
                    Width="240"
                    VerticalAlignment="Center"
                    PlaceholderText="Search apps..."
                    QueryIcon="Find"
                    TextChanged="SearchBox_TextChanged" />

                <!-- Category Tabs -->
                <StackPanel
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="AllCategoryButton"
                        Click="CategoryButton_Click"
                        Content="All"
                        Style="{StaticResource CategoryTabButton}"
                        Tag="All" />
                    <Button
                        x:Name="AppsCategoryButton"
                        Click="CategoryButton_Click"
                        Content="Apps"
                        Style="{StaticResource CategoryTabButton}"
                        Tag="Apps" />
                    <Button
                        x:Name="RuntimesCategoryButton"
                        Click="CategoryButton_Click"
                        Content="Runtimes"
                        Style="{StaticResource CategoryTabButton}"
                        Tag="Runtimes" />
                    <Button
                        x:Name="DriversCategoryButton"
                        Click="CategoryButton_Click"
                        Content="Drivers"
                        Style="{StaticResource CategoryTabButton}"
                        Tag="Drivers" />
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="RescanButton"
                        Click="RescanButton_Click"
                        Content="Rescan" />
                    <Button
                        x:Name="ListViewButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="ListViewButton_Click"
                        ToolTipService.ToolTip="List view">
                        <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                    </Button>
                    <Button
                        x:Name="GridViewButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="GridViewButton_Click"
                        ToolTipService.ToolTip="Grid view">
                        <FontIcon FontSize="14" Glyph="&#xE8A9;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Loading State -->
            <StackPanel
                x:Name="LoadingState"
                Margin="0,24,36,24"
                HorizontalAlignment="Center"
                Visibility="Collapsed">
                <ProgressRing
                    Width="32"
                    Height="32"
                    IsActive="True" />
                <TextBlock
                    Margin="0,12,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Scanning installed applications..." />
            </StackPanel>

            <!-- Empty State -->
            <StackPanel
                x:Name="EmptyState"
                Margin="0,0,36,18"
                Visibility="Collapsed">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="No apps match your search criteria."
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Apps Content Area -->
            <StackPanel x:Name="ContentArea">

                <!-- Game Launchers Section -->
                <StackPanel x:Name="GameLaunchersSection" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource CategoryTitle}" Text="Game Launchers" />
                    <ItemsControl x:Name="GameLaunchersListView" Margin="0,0,36,18">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:SettingsCard
                                    Header="{Binding DisplayName}"
                                    Description="{Binding ShortDescription}"
                                    Style="{StaticResource ConfigurationSettingsCardTemplate}">
                                    <controls:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE7FC;" />
                                    </controls:SettingsCard.HeaderIcon>
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Border
                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Style="{StaticResource InstalledBadge}">
                                            <TextBlock Style="{StaticResource InstalledBadgeText}" Text="INSTALLED" />
                                        </Border>
                                        <CheckBox
                                            Style="{StaticResource CompactAppCheckBoxStyle}"
                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityInverseConverter}}"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </StackPanel>
                                </controls:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl x:Name="GameLaunchersGridView" Margin="0,0,36,18" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid
                                    ItemWidth="200"
                                    MaximumRowsOrColumns="5"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,8,8"
                                    Padding="14"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Style="{StaticResource MonogramBorder}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Monogram}" />
                                            </Border>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{Binding DisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0,8,0,10"
                                            MaxLines="2"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding ShortDescription}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            ToolTipService.ToolTip="{Binding ShortDescription}" />
                                        <StackPanel Grid.Row="2">
                                            <Border
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Style="{StaticResource InstalledBadge}">
                                                <TextBlock Style="{StaticResource InstalledBadgeText}" Text="INSTALLED" />
                                            </Border>
                                            <CheckBox
                                                Style="{StaticResource AppCheckBoxStyle}"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityInverseConverter}}"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                Content="Select" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

