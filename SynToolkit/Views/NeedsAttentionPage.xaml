<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SynToolkit.Views.NeedsAttentionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:SynToolkit.Views"
    Loaded="Page_Loaded">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel MaxWidth="1100" Margin="36,28,36,56" Spacing="18">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Width="44"
                    Height="44"
                    VerticalAlignment="Center"
                    FontSize="32"
                    Foreground="#FFF4B400"
                    Glyph="&#xE7BA;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Text="Needs attention"
                        local:LocalizedText.TextKey="NeedsAttention" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Checks for out-of-date/missing drivers and apps, old SynToolkit version, no restore point, and out-of-sync Windows time."
                        TextWrapping="Wrap"
                        local:LocalizedText.TextKey="NeedsAttention_Subtitle" />
                </StackPanel>
                <Button
                    x:Name="RefreshButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="RefreshButton_Click"
                    Content="Refresh"
                    local:LocalizedText.ContentKey="NeedsAttention_Refresh" />
            </Grid>

            <ProgressRing
                x:Name="LoadingRing"
                Width="28"
                Height="28"
                HorizontalAlignment="Center"
                IsActive="True" />

            <InfoBar
                x:Name="AllClearInfoBar"
                IsClosable="False"
                IsOpen="False"
                Message="No checks need your attention right now."
                Severity="Success"
                Title="All clear"
                local:LocalizedText.MessageKey="NeedsAttention_AllClearDescription"
                local:LocalizedText.TitleKey="NeedsAttention_AllClear" />

            <InfoBar
                x:Name="ActionInfoBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational" />

            <ItemsControl x:Name="AttentionItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:SettingsCard
                            Margin="0,0,0,10"
                            Description="{Binding Description}"
                            Header="{Binding Title}"
                            Style="{StaticResource ConfigurationSettingsCardTemplate}">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Foreground="#FFF4B400" Glyph="&#xE7BA;" />
                            </controls:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Click="AttentionActionButton_Click"
                                    Content="{Binding ActionText}"
                                    Tag="{Binding}" />
                                <Button
                                    Click="IgnoreAttentionItemButton_Click"
                                    Content="Ignore for 3 months"
                                    Tag="{Binding}"
                                    Visibility="{Binding CanIgnore, Converter={StaticResource BoolToVisibilityConverter}}"
                                    local:LocalizedText.ContentKey="NeedsAttention_IgnoreForThreeMonths" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
