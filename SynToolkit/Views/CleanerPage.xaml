<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SynToolkit.Views.CleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SynToolkit.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="using:SynToolkit.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodel:CleanerPageViewModel}"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="55,0,0,48">
            <TextBlock
                Margin="0,24,36,8"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Disk Cleanup" />
            <TextBlock
                Margin="0,0,36,24"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Clean up temporary files, caches, and other junk to free up disk space."
                TextWrapping="Wrap" />

            <InfoBar
                x:Name="ErrorInfoBar"
                Margin="0,0,36,18"
                IsClosable="True"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Message="{Binding StatusMessage, Mode=OneWay}"
                Severity="Error"
                Title="Disk Cleanup" />

            <InfoBar
                x:Name="SuccessInfoBar"
                Margin="0,0,36,18"
                IsClosable="True"
                IsOpen="False"
                Severity="Success"
                Title="Cleanup complete" />

            <TextBlock
                Margin="0,0,0,10"
                FontSize="15"
                FontWeight="SemiBold"
                Text="Disk Space" />

            <controls:SettingsExpander
                Margin="0,0,36,16"
                Description="View storage usage and run Windows Disk Cleanup."
                Header="Drives"
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <ImageIcon Source="ms-appx:///assets/Icons/DiskCleanup.png" />
                </controls:SettingsExpander.HeaderIcon>
                <Button
                    x:Name="RunDiskCleanupButton"
                    Click="RunDiskCleanupButton_Click"
                    Content="Run Disk Cleanup"
                    Style="{StaticResource AccentButtonStyle}" />
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Name="DrivesCard" Padding="16">
                        <controls:SettingsCard.Header>
                            <ItemsControl x:Name="DrivesRepeater">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:DriveModel">
                                        <Grid Padding="8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Width="32"
                                                Height="32"
                                                VerticalAlignment="Center"
                                                Source="{x:Bind Icon, Mode=OneWay}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Label, Mode=OneWay}"
                                                    TextWrapping="NoWrap" />
                                                <ProgressBar
                                                    Margin="0,6,0,4"
                                                    Maximum="{x:Bind Total, Mode=OneWay}"
                                                    Value="{x:Bind Used, Mode=OneWay}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Free, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:SettingsCard.Header>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <TextBlock
                Margin="0,8,0,10"
                FontSize="15"
                FontWeight="SemiBold"
                Text="Junk Files" />

            <controls:SettingsExpander
                Margin="0,0,36,16"
                Description="Scan and clean temporary files, caches, logs, and other junk."
                Header="Scan &amp; Clean"
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <ImageIcon Source="ms-appx:///assets/Icons/DiskCleanup.png" />
                </controls:SettingsExpander.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button
                        x:Name="ScanButton"
                        Click="ScanButton_Click"
                        Content="Scan"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        x:Name="CleanSelectedButton"
                        Click="CleanSelectedButton_Click"
                        Content="Clean selected"
                        Visibility="{Binding HasScanned, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        IsActive="{Binding IsScanning, Mode=OneWay}"
                        Visibility="{Binding IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        IsActive="{Binding IsCleaning, Mode=OneWay}"
                        Visibility="{Binding IsCleaning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard>
                        <controls:SettingsCard.Header>
                            <StackPanel>
                                <StackPanel
                                    Margin="0,0,0,12"
                                    Orientation="Horizontal"
                                    Spacing="16"
                                    Visibility="{Binding HasScanned, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button x:Name="SelectAllButton" Click="SelectAllButton_Click" Content="Select all" />
                                    <Button x:Name="SelectNoneButton" Click="SelectNoneButton_Click" Content="Select none" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding TotalFoundText, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Text="{Binding LastCleanedText, Mode=OneWay}" />
                                <ItemsControl ItemsSource="{Binding Categories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodel:JunkCategoryItemViewModel">
                                            <Grid Margin="0,4" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind FileCountText, Mode=OneWay}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind SizeText, Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </controls:SettingsCard.Header>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

        </StackPanel>
    </ScrollViewer>
</Page>
