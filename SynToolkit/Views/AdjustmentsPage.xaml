<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SynToolkit.Views.AdjustmentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SynToolkit.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverseConverter" />
        <Style x:Key="CategoryTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,10" />
        </Style>
        <Style x:Key="WallpaperSectionHeader" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="WallpaperGridViewItemStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="WallpaperTileTemplate">
            <Grid Width="160" Margin="0,0,12,12">
                <Border
                    Visibility="{Binding IsAddTile, Converter={StaticResource BoolToVisibilityInverseConverter}}"
                    BorderBrush="{Binding BorderBrush}"
                    BorderThickness="{Binding BorderThickness}"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="90" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" CornerRadius="8,8,0,0">
                            <Grid>
                                <Border>
                                    <Border.Background>
                                        <ImageBrush
                                            ImageSource="{Binding ThumbnailPath}"
                                            Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Button
                                    Width="28"
                                    Height="28"
                                    Margin="6"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Click="DeleteCustomWallpaperButton_Click"
                                    CornerRadius="14"
                                    ToolTipService.ToolTip="Remove from Your Wallpapers"
                                    Visibility="{Binding IsDeletable, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <FontIcon FontSize="11" Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                        </Border>
                        <Border
                            Grid.Row="1"
                            Padding="10,8"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="0,0,8,8">
                            <TextBlock
                                FontSize="12"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{Binding DisplayName}" />
                        </Border>
                    </Grid>
                </Border>
                <Button
                    Height="126"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="AddCustomWallpaperButton_Click"
                    Visibility="{Binding IsAddTile, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Width="160" Height="126">
                        <Rectangle
                            Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            RadiusX="8"
                            RadiusY="8"
                            Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                            StrokeDashArray="4,3"
                            StrokeThickness="1.5" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <FontIcon
                                FontSize="22"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE710;" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Add wallpaper" />
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="55,0,0,48">
            <TextBlock
                Margin="0,24,36,8"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Customizations" />
            <TextBlock
                Margin="0,0,36,24"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Identity and local account settings that don't have a Windows Settings page on this system."
                TextWrapping="Wrap" />

            <InfoBar
                x:Name="ElevationInfoBar"
                Margin="0,0,36,18"
                IsClosable="False"
                IsOpen="False"
                Message="Administrator access is required to make identity and account changes. Restart SynToolkit as administrator."
                Severity="Warning"
                Title="Administrator access required" />

            <InfoBar
                x:Name="OperationInfoBar"
                Margin="0,0,36,18"
                IsClosable="True"
                IsOpen="False" />

            <TextBlock Style="{StaticResource CategoryTitle}" Text="Identity" />

            <controls:SettingsExpander
                Margin="0,0,36,10"
                Header="Account"
                Description="Change the signed-in user's identity."
                Style="{StaticResource ConfigurationSettingsExpanderTemplate}">
                <controls:SettingsExpander.HeaderIcon>
                    <ImageIcon Source="ms-appx:///assets/Icons/UserAccount.png" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Change password" Description="Set a new password for the signed-in account.">
                        <Button x:Name="ChangePasswordButton" Click="ChangePasswordButton_Click" Content="Change" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Change display name" Description="Set the name shown on the sign-in and Start screens.">
                        <Button x:Name="ChangeDisplayNameButton" Click="ChangeDisplayNameButton_Click" Content="Change" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Change Administrator password" Description="Set a new password for the built-in Administrator account.">
                        <Button x:Name="ChangeAdminPasswordButton" Click="ChangeAdminPasswordButton_Click" Content="Change" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander
                Margin="0,0,36,10"
                Header="Images"
                Description="Change the profile picture and lock screen image."
                Style="{StaticResource ConfigurationSettingsExpanderTemplate}">
                <controls:SettingsExpander.HeaderIcon>
                    <ImageIcon Source="ms-appx:///assets/Icons/Display.png" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Change profile picture" Description="Choose an image file to use as the account picture.">
                        <Button x:Name="ChangeProfilePictureButton" Click="ChangeProfilePictureButton_Click" Content="Choose image" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Change lock screen image" Description="Choose an image file to use as the lock screen background.">
                        <Button x:Name="ChangeLockscreenImageButton" Click="ChangeLockscreenImageButton_Click" Content="Choose image" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander
                Margin="0,0,36,10"
                Header="Keyboard language"
                Description="Add or remove a keyboard input language."
                Style="{StaticResource ConfigurationSettingsExpanderTemplate}">
                <controls:SettingsExpander.HeaderIcon>
                    <ImageIcon Source="ms-appx:///assets/Icons/Language.png" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        Header="Add keyboard language"
                        Description="Requires a language tag and keyboard identifier, e.g. en-US:00000409. See Microsoft's published language-pack and keyboard-identifier tables.">
                        <Button x:Name="AddKeyboardLanguageButton" Click="AddKeyboardLanguageButton_Click" Content="Add" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Remove keyboard language"
                        Description="Requires the same language tag and keyboard identifier used to add it.">
                        <Button x:Name="RemoveKeyboardLanguageButton" Click="RemoveKeyboardLanguageButton_Click" Content="Remove" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <TextBlock Style="{StaticResource CategoryTitle}" Text="Desktop" />

            <Border
                Margin="0,0,36,10"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <StackPanel>
                    <!-- Header with title and action buttons -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Wallpaper" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Choose a wallpaper for your Windows desktop." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="RestorePreviousButton"
                                Click="RestorePreviousButton_Click"
                                Content="Restore Previous"
                                ToolTipService.ToolTip="Undo the last wallpaper change" />
                            <Button
                                x:Name="RefreshWallpapersButton"
                                Click="RefreshWallpapersButton_Click"
                                Content="Refresh" />
                        </StackPanel>
                    </Grid>

                    <!-- Currently Applied Preview -->
                    <Border
                        Margin="0,0,0,16"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="200"
                                Height="112"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <FontIcon
                                        x:Name="CurrentWallpaperPlaceholder"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="32"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE7F4;" />
                                    <Border
                                        x:Name="CurrentWallpaperImageHost"
                                        CornerRadius="5"
                                        Visibility="Collapsed">
                                        <Border.Background>
                                            <ImageBrush
                                                x:Name="CurrentWallpaperPreview"
                                                Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">
                                <Border
                                    HorizontalAlignment="Left"
                                    Padding="8,4"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Margin="0,0,0,8">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="CURRENTLY APPLIED" />
                                </Border>
                                <TextBlock
                                    x:Name="CurrentWallpaperName"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="Loading..."
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="CurrentWallpaperPath"
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text=""
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Available Wallpapers Section -->
                    <TextBlock
                        Style="{StaticResource WallpaperSectionHeader}"
                        Text="AVAILABLE WALLPAPERS" />

                    <TextBlock
                        x:Name="WallpaperEmptyMessage"
                        Margin="0,0,0,8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No wallpapers available. The Assets\Wallpapers folder may be missing."
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <GridView
                        x:Name="WallpaperGridView"
                        IsItemClickEnabled="True"
                        ItemClick="WallpaperGridView_ItemClick"
                        ItemContainerStyle="{StaticResource WallpaperGridViewItemStyle}"
                        ItemTemplate="{StaticResource WallpaperTileTemplate}"
                        SelectionMode="None">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>

                    <!-- User-added custom wallpapers -->
                    <TextBlock
                        Margin="8,8,0,12"
                        Style="{StaticResource WallpaperSectionHeader}"
                        Text="YOUR WALLPAPERS" />

                    <GridView
                        x:Name="CustomWallpaperGridView"
                        IsItemClickEnabled="True"
                        ItemClick="CustomWallpaperGridView_ItemClick"
                        ItemContainerStyle="{StaticResource WallpaperGridViewItemStyle}"
                        ItemTemplate="{StaticResource WallpaperTileTemplate}"
                        SelectionMode="None">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
