[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\Background\shell\SynToolkitTerminals\shell\PowerShell\command]
@="powershell.exe -NoLogo -NoExit -Command Set-Location -LiteralPath '%V'"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\Background\shell\SynToolkitTerminals\shell\WindowsTerminal]
"MUIVerb"="Windows Terminal"
"Icon"="wt.exe"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\Background\shell\SynToolkitTerminals\shell\WindowsTerminal\command]
@="wt.exe -d \"%V\""
